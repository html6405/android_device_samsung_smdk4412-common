allow hal_camera_default mnt_user_file:dir search;
allow hal_camera_default gpu_device:chr_file { ioctl open read write };
allow hal_camera_default mediaserver:binder { call transfer };
allow hal_camera_default vndbinder_device:chr_file { ioctl open read write };
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;

# Samsung AIDL camera imports buffers through the Exynos4 allocator/mapper.
hal_client_domain(hal_camera_default, hal_graphics_allocator)
get_prop(hal_camera_default, camera_config_prop)
get_prop(hal_camera_default, vendor_exynos4_camera_prop)
